{
  "name": "mongoose-lint",
  "version": "0.1.0",
  "description": "Catches MongoDB schema design anti-patterns in your Mongoose models, in CI, before they reach production. Static analysis — no database, no Mongoose import.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "bin": { "mongoose-lint": "./dist/presentation/cli/cli.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "dev": "node --experimental-strip-types src/presentation/cli/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mongoose",
    "mongodb",
    "lint",
    "linter",
    "schema",
    "anti-patterns",
    "index",
    "static-analysis",
    "ts-morph",
    "cli"
  ],
  "dependencies": {
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
